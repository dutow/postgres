diff --git a/src/include/libpq/libpq-be-fe-helpers.h b/src/include/libpq/libpq-be-fe-helpers.h
index b0949280ce0..0f2cd149e55 100644
--- a/src/include/libpq/libpq-be-fe-helpers.h
+++ b/src/include/libpq/libpq-be-fe-helpers.h
@@ -347,16 +347,19 @@ libpqsrv_get_result(PGconn *conn, uint32 wait_event_info)
 	 * Collect data until PQgetResult is ready to get the result without
 	 * blocking.
 	 */
+	elog(LOG, "WRCVTRACE get_result: enter, PQisBusy=%d", PQisBusy(conn));
 	while (PQisBusy(conn))
 	{
 		int			rc;
 
+		elog(LOG, "WRCVTRACE get_result: busy, entering untimed wait");
 		rc = WaitLatchOrSocket(MyLatch,
 							   WL_EXIT_ON_PM_DEATH | WL_LATCH_SET |
 							   WL_SOCKET_READABLE,
 							   PQsocket(conn),
 							   0,
 							   wait_event_info);
+		elog(LOG, "WRCVTRACE get_result: wait returned rc=0x%x", rc);
 
 		/* Interrupted? */
 		if (rc & WL_LATCH_SET)
@@ -368,10 +371,14 @@ libpqsrv_get_result(PGconn *conn, uint32 wait_event_info)
 		/* Consume whatever data is available from the socket */
 		if (PQconsumeInput(conn) == 0)
 		{
+			elog(LOG, "WRCVTRACE get_result: PQconsumeInput=0 (EOF or error): %s",
+				 PQerrorMessage(conn));
 			/* trouble; expect PQgetResult() to return NULL */
 			break;
 		}
+		elog(LOG, "WRCVTRACE get_result: consumed ok");
 	}
+	elog(LOG, "WRCVTRACE get_result: loop done");
 
 	/* Now we can collect and return the next PGresult */
 	return PQgetResult(conn);
