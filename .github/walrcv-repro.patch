+			const char *s = getenv("PG_WALRCV_PRESLEEP_MS");
+
+			presleep_ms = s ? atoi(s) : 0;
+		}
+		if (presleep_ms > 0)
+			pg_usleep(presleep_ms * 1000L);
+	}
+
